+`;
+const MARKS = [["zhong","keeper"],["fan","insurgent"],["nei","schemer"]];
+function openIdMenu(ui, player, node, ev) {
+	document.querySelectorAll(".qx-idmenu").forEach(m => m.remove());
+	const m = document.createElement("div");
+	m.className = "qx-idmenu";
+	for (const [k, f] of MARKS) {
+		const b = document.createElement("div");
+		b.style.backgroundImage = `url(image/qx/badge-${f}.png)`;
+		b.onclick = e => { e.stopPropagation(); node.dataset.color = k; node.dataset.qxMark = k; m.remove(); };
+		m.appendChild(b);
+	}
+	const x = document.createElement("div");
+	x.className = "x";
+	x.onclick = e => { e.stopPropagation(); delete node.dataset.color; delete node.dataset.qxMark; m.remove(); };
+	m.appendChild(x);
+	const r = node.getBoundingClientRect();
+	m.style.left = Math.max(4, Math.min(innerWidth - 150, r.left - 50)) + "px";
+	m.style.top = (r.bottom + 4) + "px";
+	document.body.appendChild(m);
+	setTimeout(() => document.addEventListener("click", () => m.remove(), { once: true }), 0);
+}
+export function installTheme(lib, game, ui, get, _status) {
+	const style = document.createElement("style");
+	style.id = "qx-theme";
+	style.textContent = CSS;
+	document.head.appendChild(style);
+	// 给每个座位标上阵营，供徽章 CSS 使用
+	const tag = () => {
+		for (const p of game.players.concat(game.dead)) {
+			if (p.group && p.dataset.qxGroup !== p.group) p.dataset.qxGroup = p.group;
+			if (!p.querySelector(":scope > .qx-frame")) {
+				const f = document.createElement("div");
+				f.className = "qx-frame";
+				p.appendChild(f);
+				const e = document.createElement("div");
+				e.className = "qx-emblem";
+				p.appendChild(e);
+
+			}
+		}
+	};
+	window.QX_identityMenu = function (e) {
+		const id = this, p = id.parentNode;
+		_status_click(e);
+		if (p === game.me || p.identityShown || p.isZhu) return;
+		openIdMenu(ui, p, id, e);
+	};
+	// 自己的面板：标记、空槽位
+	const SLOT = ["武器", "防具", "−1 坐骑", "+1 坐骑"];
+	const meTick = () => {
+		for (const p of game.players.concat(game.dead)) {
+			const isMe = p === game.me;
+			p.classList.toggle("qx-me", isMe);
+			let sl = p.querySelector(":scope > .qx-slots");
+			if (isMe && !sl) {
+				sl = document.createElement("div");
+				sl.className = "qx-slots";
+				for (const t of SLOT) { const d = document.createElement("div"); d.textContent = t; sl.appendChild(d); }
+				p.appendChild(sl);
+			}
+		}
+		// 装备技能
+		const ctrls = [ui.skills, ui.skills2, ui.skills3].filter(c => c && c.style.display != "none");
+		const skills = ctrls.flatMap(c => c.skills || []);
+		const active = _status.event && _status.event.skill;
+		if (!game.me) return;
+		for (const c of game.me.querySelectorAll(":scope > .equips > .card")) {
+			const info = lib.card[c.name] || {};
+			const own = (info.skills || []).filter(s => skills.includes(s) || s === active);
+			c.qxSkill = own.find(s => skills.includes(s));
+			c.classList.toggle("qx-ready", !!c.qxSkill && active !== c.qxSkill);
+			c.classList.toggle("qx-active", !!active && (info.skills || []).includes(active));
+			for (const ct of ctrls) for (const b of ct.childNodes) if ((info.skills || []).includes(b.link)) b.style.display = "none";
+		}
+	};
+	setInterval(meTick, 150);
+	if (!document.querySelector(".qx-credit")) {
+		const cr = document.createElement("div");
+		cr.className = "qx-credit";
+		cr.innerHTML = '基于<a href="https://github.com/libnoname/noname" target="_blank">无名杀</a>（GPL-3.0）· <a href="https://github.com/catchyhand/catchyhand.github.io/tree/main/hall-of-ages-src" target="_blank">源码</a>';
+		document.body.appendChild(cr);
+	}
+	document.addEventListener("click", ev => {
+		const c = ev.target.closest && ev.target.closest("#arena > .player > .equips > .card");
+		if (!c || !game.me || !game.me.contains(c)) return;
+		const sk = c.qxSkill || (c.classList.contains("qx-active") && _status.event.skill);
+		if (!sk) return;
+		const b = [ui.skills, ui.skills2, ui.skills3].filter(Boolean).flatMap(ct => [...ct.childNodes]).find(x => x.link === sk);
+		if (!b) return;
+		ev.stopPropagation(); ev.preventDefault();
+		if (c.classList.contains("qx-active")) { ui.click.cancel(); return; }
+		ui.click.skill.call(b, sk);
+	}, true);
+	function _status_click(e) { if (e && e.stopPropagation) e.stopPropagation(); }
+	setInterval(tag, 500);
+}
