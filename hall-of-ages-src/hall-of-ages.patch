+class StaticAdapter extends BrowserAdapter {
+	async stat(path) {
+		assertValidPath(path);
+		if (!/\.[a-zA-Z0-9]+$/.test(path)) return null;
+		try {
+			const r = await fetch(encodeURI(path), { method: "HEAD" });
