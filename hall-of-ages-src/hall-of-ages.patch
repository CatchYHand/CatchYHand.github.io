+      const v = inst.def.viewAs; const n = v.count == null ? 1 : v.count;
+      if (u.sel.length !== n) return null;
+      return g.buildCard(me, { cardIds: u.sel.map(c => c.id), skill: u.skill, asName: u.asName },
