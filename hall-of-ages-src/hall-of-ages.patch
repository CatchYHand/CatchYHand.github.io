+        answer: () => { const a = { action: 'skill', skill: u.active.key, cardIds: u.sel.map(c => c.id), targets: u.targets.map(p => p.seat) }; if (u.active.option != null) a.option = u.active.option; return a; },
+      };
+    }
+    // 转化技（含装备转化技，如萨里沙长矛）
+    if (u.skill) {
